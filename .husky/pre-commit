#!/bin/sh

# Tenta encontrar o node no PATH do Windows de forma mais abrangente
export PATH="$PATH:/c/Program Files/nodejs:/c/Program Files/nodejs/bin:/c/Users/$USER/AppData/Roaming/npm"

echo "Verificando estilo e erros do código (Linter)..."

# Usa o npx, que é mais seguro para rodar binários locais
npx eslint .

if [ $? -ne 0 ]; then
    echo "❌ O código possui erros de formatação ou estilo. Commit cancelado."
    exit 1
fi

echo "✅ Código aprovado pelo Linter!"